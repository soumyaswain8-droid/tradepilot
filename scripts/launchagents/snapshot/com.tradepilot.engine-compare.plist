<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradepilot.engine-compare</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/soumyaswain/anaconda3/bin/python3</string>
        <string>/Users/soumyaswain/Documents/tinker/projects/tradepilot/scripts/engine-compare.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/soumyaswain/Documents/tinker/projects/tradepilot</string>

    <!-- Weekdays 15:40 IST — 5 min after auto-stop-eod (15:35). Telegrams the
         four-way engine comparison (RC-1 v5_long vs v5 / v5_classic / v5_cut). -->
